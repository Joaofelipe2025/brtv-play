{
  "expo": {
    "name": "BRTV PLAY",
    "slug": "brtv-play",
    "version": "0.1.1",
    "orientation": "landscape",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#06080B",
    "platforms": [
      "android"
    ],
    "android": {
      "package": "app.brtvplay.player",
      "versionCode": 2,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#06080B"
      }
    },
    "plugins": [
      "./plugins/withLeanback.js",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "icon": "./assets/icon.png",
    "owner": "brtv-play",
    "extra": {
      "eas": {
        "projectId": "cf820c71-a13b-4184-8a70-661eea62b83a"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/cf820c71-a13b-4184-8a70-661eea62b83a",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
